# Secrets — never commit. Mirrors the deny list in .claude/settings.json.
.env
.env.*
!.env.example
secrets/
wallets/
*.pem
*.key
*_seed*
*.keystore

# Local Claude Code overrides
.claude/settings.local.json

# Autonomous-run scratch. Testnet-only key material lives here and never leaves the machine.
.runtime/*
!.runtime/.gitkeep

# Node / pnpm
node_modules/
.pnpm-store/
dist/
.next/
coverage/
*.tsbuildinfo

# Pinned upstream checkouts. Reproduced by `make bootstrap` from docs/source-lock.json and
# verified against the recorded contentSha256, so the bytes never need to live in this history.
upstream/

# Foundry
out/
contracts/out/
cache/
broadcast/
!broadcast/**/dry-run/

# Go
extension/bin/
*.test

# Tooling noise
.DS_Store
*.log
